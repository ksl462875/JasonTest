#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

void bubbleSort_BUGGY(vector<int>& a) {
    size_t n = a.size();
    bool swapped = false;

    for (size_t i = n - 1; i >= 0; --i) {
        for (size_t j = 0; j <= n - i; ++j) {
            if (a[j] > a[j + 1]) {
                swap(a[j], a[j + 1]);
                swapped = true;
            }
        }
        if (!swapped) break;
    }
}

int main() {
    vector<int> v{5, 4, 3, 2, 1};
    bubbleSort_BUGGY(v);
    for (int x : v) cout << x << ' ';
    cout << '\n';
    return 0;
}
